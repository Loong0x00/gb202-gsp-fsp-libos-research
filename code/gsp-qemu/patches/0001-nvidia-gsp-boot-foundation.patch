diff --git a/target/riscv/tcg/nv_gsp.c b/target/riscv/tcg/nv_gsp.c
new file mode 100644
index 0000000..18db7f7
--- /dev/null
+++ b/target/riscv/tcg/nv_gsp.c
@@ -0,0 +1,212 @@
+/*
+ * Firmware-derived NVIDIA GSP supervisor MPU model.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Evidence is the unchanged GB20X kernel: boot 0x93000000..0x9300010e,
+ * invalidation 0x93006eae..0x93006ece, and fault/attribute table
+ * 0x9300a538..0x9300a708. No proprietary instruction is replaced by NOP.
+ * Unknown overlap priority and incongruent sub-page mappings fail explicitly.
+ */
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "cpu.h"
+#include "internals.h"
+#include "exec/cputlb.h"
+#include "exec/page-protection.h"
+#include "exec/target_page.h"
+#include "target/riscv/tcg/csr.h"
+#include "nv_gsp.h"
+
+#define NV_SMPU_INDEX 0x5ca
+#define NV_SMPU_VA    0x5cb
+#define NV_SMPU_PA    0x5cc
+#define NV_SMPU_SIZE  0x5ce
+#define NV_SMPU_ATTR  0x5cf
+#define NV_RESET_SEL  0x5d0
+#define NV_RESET_DATA 0x5d1
+#define NV_SMPU_GRANULE 1024
+
+static RISCVException nv_supervisor(CPURISCVState *env, int csrno)
+{
+    return riscv_cpu_cfg(env)->nv_gsp ? RISCV_EXCP_NONE :
+                                      RISCV_EXCP_ILLEGAL_INST;
+}
+
+static RISCVException nv_read(CPURISCVState *env, int csrno,
+                              target_ulong *value)
+{
+    RISCVNvGspMpuEntry *entry = &env->nv_smpu[env->nv_smpu_index];
+    switch (csrno) {
+    case NV_SMPU_INDEX: *value = env->nv_smpu_index; break;
+    case NV_SMPU_VA: *value = entry->va; break;
+    case NV_SMPU_PA: *value = entry->pa; break;
+    case NV_SMPU_SIZE: *value = entry->size; break;
+    case NV_SMPU_ATTR: *value = entry->attr; break;
+    case NV_RESET_SEL: *value = env->nv_indirect_index; break;
+    case NV_RESET_DATA:
+        *value = env->nv_indirect_reset[env->nv_indirect_index];
+        break;
+    default: return RISCV_EXCP_ILLEGAL_INST;
+    }
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException nv_write(CPURISCVState *env, int csrno,
+                               target_ulong value, uintptr_t ra)
+{
+    RISCVNvGspMpuEntry *entry = &env->nv_smpu[env->nv_smpu_index];
+    switch (csrno) {
+    case NV_SMPU_INDEX:
+        if (value >= RISCV_NV_GSP_SMPU_ENTRIES) {
+            return RISCV_EXCP_ILLEGAL_INST;
+        }
+        env->nv_smpu_index = value;
+        return RISCV_EXCP_NONE;
+    case NV_SMPU_VA: entry->va = value; break;
+    case NV_SMPU_PA: entry->pa = value; break;
+    case NV_SMPU_SIZE: entry->size = value; break;
+    case NV_SMPU_ATTR: entry->attr = value; break;
+    case NV_RESET_SEL:
+        if (value > 1) {
+            return RISCV_EXCP_ILLEGAL_INST;
+        }
+        env->nv_indirect_index = value;
+        return RISCV_EXCP_NONE;
+    case NV_RESET_DATA:
+        /* Only reset/clear semantics are recovered, not event programming. */
+        if (value) {
+            qemu_log_mask(LOG_UNIMP, "nv-gsp: unsupported 5d1 selector=%u value=%"
+                          PRIx64 " pc=%" PRIx64 "\n", env->nv_indirect_index,
+                          (uint64_t)value, (uint64_t)env->pc);
+            return RISCV_EXCP_ILLEGAL_INST;
+        }
+        env->nv_indirect_reset[env->nv_indirect_index] = 0;
+        return RISCV_EXCP_NONE;
+    default: return RISCV_EXCP_ILLEGAL_INST;
+    }
+    /* VA is not an atomic commit: the fault path writes VA before PA/size. */
+    tlb_flush(env_cpu(env));
+    qemu_log_mask(CPU_LOG_MMU, "nv-gsp: slot=%u va=%016" PRIx64
+                  " pa=%016" PRIx64 " size=%016" PRIx64
+                  " attr=%016" PRIx64 "\n", env->nv_smpu_index,
+                  entry->va, entry->pa, entry->size, entry->attr);
+    return RISCV_EXCP_NONE;
+}
+
+#define NV_CSR(number, name) \
+    { .csrno = number, .csr_ops = { name, nv_supervisor, nv_read, nv_write } }
+const RISCVCSR nv_gsp_csr_list[] = {
+    NV_CSR(NV_SMPU_INDEX, "nv.smpu.index"),
+    NV_CSR(NV_SMPU_VA, "nv.smpu.va"),
+    NV_CSR(NV_SMPU_PA, "nv.smpu.pa"),
+    NV_CSR(NV_SMPU_SIZE, "nv.smpu.size"),
+    NV_CSR(NV_SMPU_ATTR, "nv.smpu.attr"),
+    NV_CSR(NV_RESET_SEL, "nv.reset.select"),
+    NV_CSR(NV_RESET_DATA, "nv.reset.data"),
+    { .csrno = 0 }
+};
+
+bool riscv_nv_gsp_mpu_active(CPURISCVState *env, int mmu_idx)
+{
+    return riscv_cpu_cfg(env)->nv_gsp &&
+           mmuidx_priv(mmu_idx) != PRV_M && !mmuidx_2stage(mmu_idx) &&
+           get_field(env->satp, SATP64_MODE) == 15;
+}
+
+bool riscv_nv_gsp_mpu_translate(CPURISCVState *env, vaddr addr, int size,
+                                MMUAccessType access, int mmu_idx,
+                                hwaddr *physical, int *prot,
+                                hwaddr *tlb_size)
+{
+    const RISCVNvGspMpuEntry *matched = NULL;
+    unsigned matched_slot = 0;
+    uint64_t translated = 0, mapping_offset = 0;
+    int permissions = 0;
+    unsigned shift = mmuidx_priv(mmu_idx) == PRV_U ? 0 : 3;
+    size = MAX(size, 1);
+    *prot = 0;
+    *tlb_size = TARGET_PAGE_SIZE;
+    if ((uint64_t)addr > UINT64_MAX - ((uint64_t)size - 1)) {
+        return false;
+    }
+    for (unsigned i = 0; i < RISCV_NV_GSP_SMPU_ENTRIES; i++) {
+        const RISCVNvGspMpuEntry *e = &env->nv_smpu[i];
+        uint64_t base = e->va & ~UINT64_C(0x3ff);
+        uint64_t page_base = addr & TARGET_PAGE_MASK;
+        if (!(e->va & 1) || !e->size) {
+            continue;
+        }
+        /* A different window can begin/end inside this target page without
+         * matching the current address. Do not cache across that boundary.
+         */
+        if ((base > page_base && base - page_base < TARGET_PAGE_SIZE) ||
+            (base <= page_base && page_base - base < e->size &&
+             e->size - (page_base - base) < TARGET_PAGE_SIZE)) {
+            *tlb_size = NV_SMPU_GRANULE;
+        }
+        if (addr < base && base - addr < (uint64_t)size) {
+            error_report("nv-gsp: access crosses unresolved MPU boundary slot=%u", i);
+            exit(EXIT_FAILURE);
+        }
+        if (addr < base || addr - base >= e->size) {
+            continue;
+        }
+        uint64_t offset = addr - base;
+        if ((e->va & 0x3fe) || (e->pa & 0x3ff) ||
+            (e->size & 0x3ff) || e->pa > UINT64_MAX - offset) {
+            error_report("nv-gsp: unmodeled MPU alignment/flags slot=%u", i);
+            exit(EXIT_FAILURE);
+        }
+        uint64_t pa = e->pa + offset;
+        unsigned bits = (e->attr >> shift) & 7;
+        int p = ((bits & 1) ? PAGE_READ : 0) |
+                ((bits & 2) ? PAGE_WRITE : 0) |
+                ((bits & 4) ? PAGE_EXEC : 0);
+        if (matched && (pa != translated || p != permissions ||
+                        e->attr != matched->attr)) {
+            error_report("nv-gsp: unresolved overlapping MPU priority slots=%u/%u",
+                         matched_slot, i);
+            exit(EXIT_FAILURE);
+        }
+        if ((uint64_t)size > e->size - offset ||
+            pa > UINT64_MAX - ((uint64_t)size - 1)) {
+            return false;
+        }
+        if (((pa ^ addr) & (TARGET_PAGE_SIZE - 1)) != 0) {
+            error_report("nv-gsp: incongruent sub-page mapping not implemented slot=%u", i);
+            exit(EXIT_FAILURE);
+        }
+        matched = e;
+        matched_slot = i;
+        translated = pa;
+        mapping_offset = offset;
+        permissions = p;
+        uint64_t page_offset = addr & (TARGET_PAGE_SIZE - 1);
+        if (offset < page_offset ||
+            e->size - (offset - page_offset) < TARGET_PAGE_SIZE) {
+            *tlb_size = NV_SMPU_GRANULE;
+        }
+    }
+    if (!matched) {
+        qemu_log_mask(CPU_LOG_MMU, "nv-gsp: miss va=%016" PRIx64 "\n",
+                      (uint64_t)addr);
+        return false;
+    }
+    int required = access == MMU_INST_FETCH ? PAGE_EXEC :
+                   access == MMU_DATA_STORE ? PAGE_WRITE : PAGE_READ;
+    *prot = permissions;
+    if (!(permissions & required)) {
+        qemu_log_mask(CPU_LOG_MMU, "nv-gsp: denied slot=%u va=%016" PRIx64
+                      " access=%u priv=%u attr=%016" PRIx64 "\n",
+                      matched_slot, (uint64_t)addr, access,
+                      mmuidx_priv(mmu_idx), matched->attr);
+        return false;
+    }
+    *physical = translated;
+    qemu_log_mask(CPU_LOG_MMU, "nv-gsp: hit slot=%u va=%016" PRIx64
+                  " pa=%016" PRIx64 " offset=%" PRIx64 " prot=%x\n",
+                  matched_slot, (uint64_t)addr, translated, mapping_offset,
+                  permissions);
+    return true;
+}
