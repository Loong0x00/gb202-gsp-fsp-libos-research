diff --git a/hw/riscv/nvidia_gsp.c b/hw/riscv/nvidia_gsp.c
new file mode 100644
index 0000000..81d47ed
--- /dev/null
+++ b/hw/riscv/nvidia_gsp.c
@@ -0,0 +1,213 @@
+/*
+ * NVIDIA GSP boot-chain development harness.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * No synthetic M-mode monitor, no LibOS entry shortcut and no assumed
+ * BootROM decryption key. CPU execution requires an explicit ROM image,
+ * its expected digest, and a configured ROM address. The address layout
+ * is a harness configuration, not an asserted GB202 silicon memory map.
+ */
+#include "qemu/osdep.h"
+#include "hw/core/boards.h"
+#include "hw/riscv/machines-qom.h"
+#include "hw/core/loader.h"
+#include "qapi/error.h"
+#include "qemu/cutils.h"
+#include "qemu/error-report.h"
+#include "qemu/units.h"
+#include "system/address-spaces.h"
+#include "system/reset.h"
+#include "cpu.h"
+#include "nvidia_gsp_boot.h"
+#include <openssl/evp.h>
+
+#define TYPE_NVIDIA_GSP_MACHINE MACHINE_TYPE_NAME("nvidia-gsp")
+OBJECT_DECLARE_SIMPLE_TYPE(NvidiaGspMachine, NVIDIA_GSP_MACHINE)
+
+struct NvidiaGspMachine {
+    MachineState parent_obj;
+    MemoryRegion rom;
+    char *fmc, *bootloader, *trusted_key, *rom_base, *rom_sha256;
+};
+
+static const char production_key_sha256[] =
+    "af870e5dde972840588bfb94a87f94b19ad6659dae6e1343dd0d22f16074ba39";
+
+static GBytes *read_input(const char *path, const char *label)
+{
+    struct stat st;
+    int fd = path ? open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK) : -1;
+    if (fd < 0) {
+        error_report("GSP %s input required/read failed: %s", label,
+                     path ? strerror(errno) : "missing path");
+        exit(EXIT_FAILURE);
+    }
+    /* Reject oversized files and special files before allocating or blocking. */
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) ||
+        st.st_size <= 0 || st.st_size > 128 * MiB) {
+        close(fd);
+        error_report("GSP %s input length/type invalid", label);
+        exit(EXIT_FAILURE);
+    }
+    gsize size = st.st_size;
+    char *data = g_try_malloc(size + 1);
+    FILE *file = fdopen(fd, "rb");
+    if (!data || !file) {
+        if (file) {
+            fclose(file);
+        } else {
+            close(fd);
+        }
+        g_free(data);
+        error_report("GSP %s bounded read setup failed", label);
+        exit(EXIT_FAILURE);
+    }
+    /* One extra byte detects growth after fstat without exceeding the cap. */
+    size_t count = fread(data, 1, size + 1, file);
+    bool bad_read = ferror(file) || count != size;
+    fclose(file);
+    if (bad_read) {
+        g_free(data);
+        error_report("GSP %s input changed or read failed", label);
+        exit(EXIT_FAILURE);
+    }
+    return g_bytes_new_take(data, size);
+}
+
+static void nvidia_gsp_cpu_reset(void *opaque)
+{
+    cpu_reset(CPU(opaque));
+}
+
+static void nvidia_gsp_init(MachineState *machine)
+{
+    NvidiaGspMachine *s = NVIDIA_GSP_MACHINE(machine);
+    g_autoptr(GBytes) fmc = NULL, bootloader = NULL, rom = NULL;
+    NvGspGfw gfw;
+    NvGspBootImage boot;
+    char error[256], rom_digest[65];
+    gsize fmc_size, boot_size, rom_size;
+    uint64_t rom_base;
+    unsigned char digest[EVP_MAX_MD_SIZE];
+    unsigned digest_size;
+
+    if (machine->kernel_filename || machine->initrd_filename) {
+        error_report("GSP forbids -kernel/-initrd shortcuts; supply the original ROM with -bios");
+        exit(EXIT_FAILURE);
+    }
+    fmc = read_input(s->fmc, "production GFW");
+    bootloader = read_input(s->bootloader, "production ROM package");
+    const void *fmc_data = g_bytes_get_data(fmc, &fmc_size);
+    const void *boot_data = g_bytes_get_data(bootloader, &boot_size);
+    if (!nv_gsp_parse_gfw(fmc_data, fmc_size, &gfw, error, sizeof(error)) ||
+        !nv_gsp_verify_gfw(&gfw, s->trusted_key, error, sizeof(error)) ||
+        !nv_gsp_parse_boot_image(boot_data, boot_size, &boot, error, sizeof(error)) ||
+        !nv_gsp_match_boot_images(&gfw, &boot, error, sizeof(error))) {
+        error_report("GSP stage=REJECTED: %s", error);
+        exit(EXIT_FAILURE);
+    }
+    info_report("GSP stage=SIGNED_PACKET_VERIFIED SHA384/ECDSA-P384; code=%zu data=%zu manifest=%zu",
+                boot.code.size, boot.data.size, boot.manifest.size);
+    if (!machine->firmware || !s->rom_base || !s->rom_sha256) {
+        error_report("GSP stage=BOOTROM_REQUIRED: authenticated packet is not an executable ROM. "
+                     "Supply -bios ROM, rom-base and rom-sha256. No CPU/FMC/LibOS handoff was performed; "
+                     "on-chip authentication, decoding/decryption and fuse policy remain unimplemented.");
+        exit(EXIT_FAILURE);
+    }
+    if (qemu_strtou64(s->rom_base, NULL, 0, &rom_base) ||
+        (rom_base & 4095) || strlen(s->rom_sha256) != 64) {
+        error_report("GSP invalid ROM address/digest configuration");
+        exit(EXIT_FAILURE);
+    }
+    rom = read_input(machine->firmware, "BootROM");
+    const void *rom_data = g_bytes_get_data(rom, &rom_size);
+    if (rom_size > MiB || rom_base > UINT64_MAX - MiB ||
+        (rom_base < 0x80000000ULL + machine->ram_size &&
+         rom_base + ROUND_UP(rom_size, 4096) > 0x80000000ULL)) {
+        error_report("GSP ROM range invalid or overlaps staging RAM");
+        exit(EXIT_FAILURE);
+    }
+    if (!EVP_Digest(rom_data, rom_size, digest, &digest_size, EVP_sha256(), NULL)) {
+        error_report("GSP ROM SHA256 failed");
+        exit(EXIT_FAILURE);
+    }
+    for (unsigned i = 0; i < 32; i++) {
+        snprintf(rom_digest + i * 2, 3, "%02x", digest[i]);
+    }
+    if (strcmp(rom_digest, s->rom_sha256)) {
+        error_report("GSP ROM differs from pinned SHA256");
+        exit(EXIT_FAILURE);
+    }
+    memory_region_add_subregion(get_system_memory(), 0x80000000, machine->ram);
+    memory_region_init_rom(&s->rom, NULL, "gsp.supplied-bootrom",
+                           ROUND_UP(rom_size, 4096), &error_fatal);
+    memcpy(memory_region_get_ram_ptr(&s->rom), rom_data, rom_size);
+    memory_region_add_subregion(get_system_memory(), rom_base, &s->rom);
+    RISCVCPU *cpu = RISCV_CPU(object_new(machine->cpu_type));
+    object_property_set_int(OBJECT(cpu), "resetvec", rom_base, &error_fatal);
+    qdev_realize(DEVICE(cpu), NULL, &error_fatal);
+    qemu_register_reset(nvidia_gsp_cpu_reset, cpu);
+    cpu_reset(CPU(cpu));
+    info_report("GSP stage=SUPPLIED_ROM_READY pc=0x%" PRIx64
+                "; platform MMIO/CSR/decryption are not yet implemented", rom_base);
+}
+
+#define GSP_STRING_PROPERTY(field) \
+static char *get_##field(Object *obj, Error **errp) \
+{ return g_strdup(NVIDIA_GSP_MACHINE(obj)->field); } \
+static void set_##field(Object *obj, const char *value, Error **errp) \
+{ NvidiaGspMachine *s = NVIDIA_GSP_MACHINE(obj); g_free(s->field); \
+  s->field = g_strdup(value); }
+
+GSP_STRING_PROPERTY(fmc)
+GSP_STRING_PROPERTY(bootloader)
+GSP_STRING_PROPERTY(trusted_key)
+GSP_STRING_PROPERTY(rom_base)
+GSP_STRING_PROPERTY(rom_sha256)
+
+static void nvidia_gsp_instance_init(Object *obj)
+{
+    NVIDIA_GSP_MACHINE(obj)->trusted_key = g_strdup(production_key_sha256);
+}
+
+static void nvidia_gsp_finalize(Object *obj)
+{
+    NvidiaGspMachine *s = NVIDIA_GSP_MACHINE(obj);
+    g_free(s->fmc);
+    g_free(s->bootloader);
+    g_free(s->trusted_key);
+    g_free(s->rom_base);
+    g_free(s->rom_sha256);
+}
+
+static void nvidia_gsp_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "NVIDIA GSP experimental CPU / original-ROM audit harness";
+    mc->init = nvidia_gsp_init;
+    mc->default_cpu_type = TYPE_RISCV_CPU_NVIDIA_GSP;
+    mc->default_ram_size = 128 * MiB;
+    mc->default_ram_id = "gsp.staging-ram";
+    mc->max_cpus = 1;
+    object_class_property_add_str(oc, "fmc", get_fmc, set_fmc);
+    object_class_property_add_str(oc, "bootloader", get_bootloader, set_bootloader);
+    object_class_property_add_str(oc, "trusted-key-sha256", get_trusted_key, set_trusted_key);
+    object_class_property_add_str(oc, "rom-base", get_rom_base, set_rom_base);
+    object_class_property_add_str(oc, "rom-sha256", get_rom_sha256, set_rom_sha256);
+}
+
+static const TypeInfo nvidia_gsp_machine_type = {
+    .name = TYPE_NVIDIA_GSP_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(NvidiaGspMachine),
+    .instance_init = nvidia_gsp_instance_init,
+    .instance_finalize = nvidia_gsp_finalize,
+    .class_init = nvidia_gsp_class_init,
+    .interfaces = riscv64_machine_interfaces,
+};
+
+static void nvidia_gsp_register_types(void)
+{
+    type_register_static(&nvidia_gsp_machine_type);
+}
+type_init(nvidia_gsp_register_types)
diff --git a/hw/riscv/nvidia_gsp_boot.c b/hw/riscv/nvidia_gsp_boot.c
new file mode 100644
index 0000000..f5fdf51
--- /dev/null
+++ b/hw/riscv/nvidia_gsp_boot.c
@@ -0,0 +1,286 @@
+/*
+ * NVIDIA GSP production boot packet validation.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Formats: NVIDIA 610.57.04 nouveau/extract-firmware-nouveau.py,
+ * rmRiscvUcode.h, and generated GB202 production bindata. This does NOT
+ * implement the on-chip BootROM, FSP authentication policy, or decryption.
+ */
+#include "nvidia_gsp_boot.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/ecdsa.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+#include <zlib.h>
+
+static bool fail(char *error, size_t size, const char *fmt, ...)
+    __attribute__((format(printf, 3, 4)));
+
+static bool fail(char *error, size_t size, const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(error, size, fmt, ap);
+    va_end(ap);
+    return false;
+}
+
+static uint16_t le16(const uint8_t *p)
+{
+    return p[0] | (uint16_t)p[1] << 8;
+}
+
+static uint32_t le32(const uint8_t *p)
+{
+    return le16(p) | (uint32_t)le16(p + 2) << 16;
+}
+
+static bool inside(size_t total, size_t off, size_t len)
+{
+    return off <= total && len <= total - off;
+}
+
+static bool overlap(size_t a, size_t an, size_t b, size_t bn)
+{
+    return an && bn && a < b + bn && b < a + an;
+}
+
+bool nv_gsp_parse_gfw(const void *buffer, size_t size, NvGspGfw *out,
+                     char *error, size_t error_size)
+{
+    const uint8_t *data = buffer;
+    uint32_t shoff, stroff, strsize;
+    uint16_t count, names;
+    unsigned found = 0;
+    NvGspSpan spans[4] = {0};
+    static const char *const required[] = {
+        "image", "hash", "signature", "publickey"
+    };
+
+    memset(out, 0, sizeof(*out));
+    if (size < 52 || memcmp(data, "\177ELF\1\1\1", 7) ||
+        le16(data + 40) != 52 || le16(data + 46) != 40) {
+        return fail(error, error_size, "GFW: expected little-endian ELF32 container");
+    }
+    shoff = le32(data + 32);
+    count = le16(data + 48);
+    names = le16(data + 50);
+    if (!count || count > 64 || names >= count ||
+        !inside(size, shoff, (size_t)count * 40)) {
+        return fail(error, error_size, "GFW: invalid section table");
+    }
+    const uint8_t *strhdr = data + shoff + names * 40;
+    stroff = le32(strhdr + 16);
+    strsize = le32(strhdr + 20);
+    if (le32(strhdr + 4) != 3 || !strsize || !inside(size, stroff, strsize)) {
+        return fail(error, error_size, "GFW: invalid section names");
+    }
+    for (unsigned i = 1; i < count; i++) {
+        const uint8_t *h = data + shoff + i * 40;
+        uint32_t nameoff = le32(h), off = le32(h + 16), len = le32(h + 20);
+        if (nameoff >= strsize ||
+            !memchr(data + stroff + nameoff, 0, strsize - nameoff) ||
+            !inside(size, off, len)) {
+            return fail(error, error_size, "GFW: invalid section %u", i);
+        }
+        const char *name = (const char *)data + stroff + nameoff;
+        for (unsigned j = 0; j < 4; j++) {
+            if (strcmp(name, required[j])) {
+                continue;
+            }
+            if ((found & (1U << j)) || le32(h + 4) != 1 || !len ||
+                overlap(off, len, 0, 52) ||
+                overlap(off, len, shoff, (size_t)count * 40) ||
+                overlap(off, len, stroff, strsize)) {
+                return fail(error, error_size, "GFW: duplicate/invalid %s section", name);
+            }
+            for (unsigned k = 0; k < 4; k++) {
+                if (spans[k].data && overlap(off, len,
+                    (size_t)(spans[k].data - data), spans[k].size)) {
+                    return fail(error, error_size, "GFW: overlapping payload sections");
+                }
+            }
+            if ((uint32_t)crc32(0, data + off, len) != le32(h + 28)) {
+                return fail(error, error_size, "GFW: CRC mismatch in %s", name);
+            }
+            spans[j] = (NvGspSpan){data + off, len};
+            found |= 1U << j;
+        }
+    }
+    if (found != 15 || spans[1].size != 48 || spans[2].size != 96 ||
+        spans[3].size != 97 || spans[3].data[0] != 4) {
+        return fail(error, error_size, "GFW: missing/unsupported SHA384/P384 fields");
+    }
+    *out = (NvGspGfw){spans[0], spans[1], spans[2], spans[3]};
+    return true;
+}
+
+bool nv_gsp_verify_gfw(const NvGspGfw *gfw, const char *trusted_key_sha256,
+                      char *error, size_t error_size)
+{
+    unsigned char digest[EVP_MAX_MD_SIZE];
+    unsigned int digest_size;
+    char fingerprint[65];
+    EVP_PKEY_CTX *ctx = NULL, *verify = NULL;
+    EVP_PKEY *key = NULL;
+    ECDSA_SIG *sig = NULL;
+    BIGNUM *r = NULL, *s = NULL;
+    unsigned char *der = NULL;
+    int der_size;
+    bool ok = false;
+    char group[] = "secp384r1";
+
+    if (!trusted_key_sha256 || strlen(trusted_key_sha256) != 64) {
+        return fail(error, error_size, "GFW: explicit trusted public-key SHA256 required");
+    }
+    if (!EVP_Digest(gfw->public_key.data, gfw->public_key.size, digest,
+                    &digest_size, EVP_sha256(), NULL)) {
+        return fail(error, error_size, "GFW: key fingerprint computation failed");
+    }
+    for (unsigned i = 0; i < 32; i++) {
+        snprintf(fingerprint + i * 2, 3, "%02x", digest[i]);
+    }
+    if (strcmp(fingerprint, trusted_key_sha256)) {
+        return fail(error, error_size, "GFW: public key does not match pinned trust anchor");
+    }
+    if (!EVP_Digest(gfw->image.data, gfw->image.size, digest, &digest_size,
+                    EVP_sha384(), NULL) || digest_size != 48 ||
+        memcmp(digest, gfw->hash.data, 48)) {
+        return fail(error, error_size, "GFW: SHA384 image digest mismatch");
+    }
+    ctx = EVP_PKEY_CTX_new_from_name(NULL, "EC", NULL);
+    OSSL_PARAM params[] = {
+        OSSL_PARAM_construct_utf8_string(OSSL_PKEY_PARAM_GROUP_NAME, group, 0),
+        OSSL_PARAM_construct_octet_string(OSSL_PKEY_PARAM_PUB_KEY,
+            (void *)gfw->public_key.data, gfw->public_key.size),
+        OSSL_PARAM_construct_end()
+    };
+    if (!ctx || EVP_PKEY_fromdata_init(ctx) <= 0 ||
+        EVP_PKEY_fromdata(ctx, &key, EVP_PKEY_PUBLIC_KEY, params) <= 0) {
+        fail(error, error_size, "GFW: invalid P384 public key");
+        goto done;
+    }
+    r = BN_bin2bn(gfw->signature.data, 48, NULL);
+    s = BN_bin2bn(gfw->signature.data + 48, 48, NULL);
+    sig = ECDSA_SIG_new();
+    if (!r || !s || !sig || !ECDSA_SIG_set0(sig, r, s)) {
+        fail(error, error_size, "GFW: invalid ECDSA signature encoding");
+        goto done;
+    }
+    r = s = NULL;
+    der_size = i2d_ECDSA_SIG(sig, &der);
+    verify = EVP_PKEY_CTX_new(key, NULL);
+    if (der_size <= 0 || !verify || EVP_PKEY_verify_init(verify) <= 0 ||
+        EVP_PKEY_CTX_set_signature_md(verify, EVP_sha384()) <= 0 ||
+        EVP_PKEY_verify(verify, der, der_size, digest, 48) != 1) {
+        fail(error, error_size, "GFW: P384 signature verification failed");
+        goto done;
+    }
+    ok = true;
+done:
+    OPENSSL_free(der);
+    BN_free(r);
+    BN_free(s);
+    ECDSA_SIG_free(sig);
+    EVP_PKEY_CTX_free(verify);
+    EVP_PKEY_free(key);
+    EVP_PKEY_CTX_free(ctx);
+    return ok;
+}
+
+bool nv_gsp_parse_boot_image(const void *buffer, size_t size,
+                            NvGspBootImage *out, char *error,
+                            size_t error_size)
+{
+    const uint8_t *data = buffer, *desc;
+    uint32_t descoff, imageoff, imagesize, total;
+    NvGspSpan parts[3];
+    const unsigned offset_fields[] = {8, 12, 10}; /* manifest, code, data */
+
+    memset(out, 0, sizeof(*out));
+    if (size < 24 || le32(data) != 0x10de || le32(data + 4) != 1) {
+        return fail(error, error_size, "FMC: invalid nvfw_bin_hdr");
+    }
+    total = le32(data + 8);
+    descoff = le32(data + 12);
+    imageoff = le32(data + 16);
+    imagesize = le32(data + 20);
+    if (descoff != 24 || imageoff != 116 ||
+        !inside(size, imageoff, imagesize) || size != (size_t)imageoff + imagesize ||
+        ((size + 255) & ~(size_t)255) != total) {
+        return fail(error, error_size, "FMC: invalid v6 descriptor/image bounds");
+    }
+    desc = data + descoff;
+    if (le32(desc) != 6 || le32(desc + 14 * 4) != 1) {
+        return fail(error, error_size, "FMC: unsupported descriptor or disabled monitor");
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        unsigned field = offset_fields[i];
+        uint32_t off = le32(desc + field * 4), len = le32(desc + (field + 1) * 4);
+        if (!len || (off & 255) || (len & 255) || !inside(imagesize, off, len)) {
+            return fail(error, error_size, "FMC: invalid/alignment error in descriptor range %u", i);
+        }
+        for (unsigned j = 0; j < i; j++) {
+            if (overlap(off, len, (size_t)(parts[j].data - data - imageoff), parts[j].size)) {
+                return fail(error, error_size, "FMC: overlapping descriptor ranges");
+            }
+        }
+        parts[i] = (NvGspSpan){data + imageoff + off, len};
+    }
+    *out = (NvGspBootImage){6, {data + imageoff, imagesize},
+                            parts[0], parts[1], parts[2]};
+    return true;
+}
+
+bool nv_gsp_match_boot_images(const NvGspGfw *gfw,
+                             const NvGspBootImage *boot,
+                             char *error, size_t error_size)
+{
+    const uint8_t *h = gfw->image.data;
+    size_t size = gfw->image.size;
+    if (size < 72 || h[0] != 3 || le16(h + 2) != 72 ||
+        le32(h + 4) != size - 72 || le32(h + 12) != boot->code.size ||
+        le32(h + 20) != boot->data.size ||
+        size - 72 != boot->code.size + boot->data.size + boot->manifest.size ||
+        memcmp(h + 72, boot->code.data, boot->code.size) ||
+        memcmp(h + 72 + boot->code.size, boot->data.data, boot->data.size) ||
+        memcmp(h + 72 + boot->code.size + boot->data.size,
+               boot->manifest.data, boot->manifest.size)) {
+        return fail(error, error_size, "FMC: GFW and ROM boot payloads do not match");
+    }
+    return true;
+}
+
+bool nv_gsp_boot_dma_plan(const NvGspBootImage *boot, uint64_t sysmem_base,
+                          NvGspBootDmaPlan *plan, char *error,
+                          size_t error_size)
+{
+    /* NVIDIA 610.57.04 _kgspBootstrapGspFmc_GH100 and dev_riscv_pri.h:
+     * addresses are shifted by 8; BCR address HI implements bits 11:0.
+     * This API requires a successfully parsed, unchanged BootImage.
+     */
+    const uint64_t physical_limit = UINT64_C(1) << 52;
+    uint64_t manifest, code, data;
+    memset(plan, 0, sizeof(*plan));
+    if ((sysmem_base & 255) || sysmem_base >= physical_limit ||
+        boot->image.size > physical_limit - sysmem_base) {
+        return fail(error, error_size, "FMC: unaligned/out-of-range BootROM DMA placement");
+    }
+    manifest = (sysmem_base + (boot->manifest.data - boot->image.data)) >> 8;
+    code = (sysmem_base + (boot->code.data - boot->image.data)) >> 8;
+    data = (sysmem_base + (boot->data.data - boot->image.data)) >> 8;
+    *plan = (NvGspBootDmaPlan){
+        .dmacfg = UINT32_C(0x80000001), /* LOCKED | COHERENT_SYSMEM */
+        .manifest_lo = manifest,
+        .manifest_hi = manifest >> 32,
+        .code_lo = code,
+        .code_hi = code >> 32,
+        .data_lo = data,
+        .data_hi = data >> 32,
+    };
+    return true;
+}
