+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_RISCV_NVIDIA_GSP_BOOT_H
+#define HW_RISCV_NVIDIA_GSP_BOOT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Host-side packet validation only. No instruction or BootROM emulation. */
+typedef struct NvGspSpan {
+    const uint8_t *data;
+    size_t size;
+} NvGspSpan;
+
+typedef struct NvGspGfw {
+    NvGspSpan image, hash, signature, public_key;
+} NvGspGfw;
+
+typedef struct NvGspBootImage {
+    uint32_t descriptor_version;
+    NvGspSpan image, manifest, code, data;
+} NvGspBootImage;
+
+/* Host-programmed BootROM DMA register values, not a boot-success token. */
+typedef struct NvGspBootDmaPlan {
+    uint32_t dmacfg;
+    uint32_t manifest_lo, manifest_hi;
+    uint32_t code_lo, code_hi;
+    uint32_t data_lo, data_hi;
+} NvGspBootDmaPlan;
+
+bool nv_gsp_parse_gfw(const void *data, size_t size, NvGspGfw *out,
+                     char *error, size_t error_size);
+bool nv_gsp_verify_gfw(const NvGspGfw *gfw, const char *trusted_key_sha256,
+                      char *error, size_t error_size);
+bool nv_gsp_parse_boot_image(const void *data, size_t size,
+                            NvGspBootImage *out, char *error,
+                            size_t error_size);
+bool nv_gsp_match_boot_images(const NvGspGfw *gfw,
+                             const NvGspBootImage *boot,
+                             char *error, size_t error_size);
+bool nv_gsp_boot_dma_plan(const NvGspBootImage *boot, uint64_t sysmem_base,
+                          NvGspBootDmaPlan *plan, char *error,
+                          size_t error_size);
+#endif
